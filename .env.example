# ==============================================================
# TradeNest Marketplace - Environment Variables Configuration
# ==============================================================
# For Vercel Deployment:
# Add these variables under Project Settings -> Environment Variables in your Vercel Dashboard.
#
# For Local Development:
# Copy this file to .env in the project root and fill in the values.
# ==============================================================

# Database: MySQL Connection String (URL Format)
# Supports TiDB Cloud, Aiven, Railway, AWS RDS, PlanetScale, Clever Cloud, etc.
# Format: mysql://<username>:<password>@<host>:<port>/<database>
MYSQL_URI=mysql://root:password@localhost:3306/tradenest

# Optional: Individual MySQL Parameters (Alternative to MYSQL_URI)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=password
# MYSQL_DATABASE=tradenest
# MYSQL_SSL=true

# Authentication: Secure random secret key for signing JSON Web Tokens (Pre-generated)
JWT_SECRET=4cc385478345b6af501171cf632f9a1ceaf16e010565fe8f0ee881a2eb779659

# Session: Secret used for express session management (Pre-generated)
SESSION_SECRET=9e01f99a6daba1af335a3db1e4945979f53bdd6b0a30142a5d8a7bb265cb4b13

# Security: Google reCAPTCHA v2 / v3 secret key (optional in development, recommended in production)
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# AI Chatbot: Google Gemini API Key for 24/7 intelligent customer support (or OPENAI_API_KEY)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model (Defaults to gemini-3.8-flash, can also be gemini-3.5-flash-lite or gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.8-flash

# Optional OpenAI fallback
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# URLs (Optional - automatically inferred on Vercel)
# APP_URL=https://your-tradenest-deployment.vercel.app
